---
import { Image } from "astro:assets";
import footerLogo from "../assets/images/footerLogo.webp";
---

<footer class="pt-lg h-full font-display" role="contentinfo">
  <section class="md:grid grid-cols-5 gap-4 px-sm pt-lg">
    <!-- 1. kolonne -->
    <nav class="col-span-1" aria-label="Company links">
      <ul>
        <li class="pb-2 hover:text-primary-500">
          <a href="/about">About</a>
        </li>
        <li class="pb-2 hover:text-primary-500">
          <a href="/contact">Contact</a>
        </li>
        <li class="pb-2 hover:text-primary-500">
          <a href="/faq">FAQ</a>
        </li>
        <li class="pb-2 hover:text-primary-500">
          <a
            href="/Priser-og-politik.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            Terms and Conditions
          </a>
          <li class="pb-2 hover:text-primary-500">
          <a
            href="https://www.instagram.com/klaras.table/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        </li>
        </li>
      </ul>
    </nav>
  </section>

  <!-- Footer logo -->
  <section class="text-center mt-sm">
    <Image src={footerLogo} alt="Klaras Table footer logo" class="pt-xs" />
  </section>
</footer>
