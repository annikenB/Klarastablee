---
// Props
const { title, message, onClose = "closeModal()" } = Astro.props;
---

<div id="modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-2xl shadow-lg p-6 w-full max-w-md relative">
    <!-- Luk knap -->
    <button onclick={onClose} class="absolute top-3 right-4 text-gray-500 hover:text-gray-800 text-xl">
      &times;
    </button>
    <h2 class="text-xl font-bold mb-2">{title}</h2>
    <p class="mb-6 text-gray-700">{message}</p>
    <button onclick={onClose} class="bg-gray-800 text-white px-4 py-2 rounded hover:bg-gray-900">
      Fortsæt shopping
    </button>
  </div>
</div>