---
const {
  href = "#",
  label = "Klikk her",
  variant = "primary", // "primary" eller "secondary"
} = Astro.props;

const baseStyles =
  "inline-block text-sm sm:text-base text-center transition-colors duration-300 ";

const variantStyles = {
  primary:
    "border-1 !border-primary-500 text-primary-500 hover:bg-primary-500 hover:text-beige-100 font-display px-6 sm:px-18 py-2",
  secondary:
    "border-1 !border-primary-900 text-primary-900 hover:bg-primary-900 hover:text-beige-100 font-display px-6 sm:px-18 py-2",
};

const linkClass = `${baseStyles} ${variantStyles[variant] || variantStyles.primary}`;
---

<a href={href} class={linkClass}>
  {label}
</a>
