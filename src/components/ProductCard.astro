---
import Linkbutton from "../components/Linkbutton.astro";
const {
  title = "Standard produkt",
  price = "Pris ikke oppgitt",
  details = "Produktdetaljer kommer her.",
  otherInfo = "Annen info som levering, vilkår osv.",
  buttonLabel = "Start your Order",
  href = "",
} = Astro.props;
---

<div class="sticky top-4 self-start">
  <div>
    <h1 class=" text-primary-900">{title}</h1>
    <h5 class="leading-relaxed mt-2 text-primary-900 mb-sm">{price}</h5>
  </div>

  <div class="flex border-b !border-primary-900">
    <div class="flex flex-col">
      <input type="radio" name="tabs" id="tab1" class="hidden peer" checked />
      <label
        for="tab1"
        class="cursor-pointerpy-2 !border-primary-900 peer-checked:text-primary-500 peer-checked:border-b-1 peer-checked:border-primary-500"
      >
        <h5 class="border-1 !border-primary-900">Description</h5>
      </label>
      <div class="hidden peer-checked:block">
        <p class="">{details}</p>
      </div>
    </div>

    <div class="flex flex-col ml-8">
      <input type="radio" name="tabs" id="tab2" class="hidden peer" />
      <label
        for="tab2"
        class="cursor-pointer px-4 py-2 text-gray-600 peer-checked:text-primary-500 peer-checked:border-b-2 peer-checked:border-primary-500"
      >
        <h5>Additional services</h5>
      </label>
      <div class="hidden peer-checked:block mt-4">
        <p class="text-gray-700">{otherInfo}</p>
      </div>
      
    </div>
  </div>
  <div class="my-sm">
    <a
      href="/stepone"
      class="bg-beige-100 text-primary-500 border-2 border-primary-500 hover:text-primary-500 transition inline-block text-center"
    >
      <Linkbutton href="/stepone" label="START YOUR ORDER" variant="primary" />
    </a>
  </div>
</div>
