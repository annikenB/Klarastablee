---
import Linkbutton from "../components/Linkbutton.astro";
const {
  title = "Standard produkt",
  price = "Pris ikke oppgitt",
  details = "Produktdetaljer kommer her.",
  otherInfo = "Annen info som levering, vilkår osv.",
  buttonLabel = "Start your Order",
  href = "",
} = Astro.props;
---

<div class="sticky top-4 self-start max-w-3xl">
  <div class="text-center md:text-left">
    <h1 class="text-primary-900">{title}</h1>
    <h5 class="leading-relaxed mt-2 text-primary-900 mb-sm">{price}</h5>
  </div>

  <!-- TABS -->
  <div
    class="flex flex-col items-center md:flex-row md:items-start text-center md:text-left"
  >
    <!-- Description tab -->
    <div class="w-full md:w-1/2">
      <input type="radio" name="tabs" id="tab1" class="hidden peer" checked />
      <label
        for="tab1"
        class="inline-block py-2 cursor-pointer border-b-1 !border-primary-900
      peer-checked:!text-primary-500 peer-checked:italic
      peer-checked:!border-primary-500 pb-1"
      >
        <h5 class="peer-checked:!text-primary-500">Description</h5>
      </label>
      <div class="hidden peer-checked:block mt-4">
        <p class="text-gray-700 max-w-prose mx-auto md:mx-0">{details}</p>
      </div>
    </div>

    <!-- Additional services tab -->
    <div class="w-full md:w-1/2 mt-4 md:mt-0">
      <input type="radio" name="tabs" id="tab2" class="hidden peer" />
      <label
        for="tab2"
        class="inline-block py-2 cursor-pointer border-b-1 !border-primary-900
      peer-checked:!text-primary-500 peer-checked:italic
      peer-checked:!border-primary-500 pb-1"
      >
        <h5 class="inline-block pb-1">Additional services</h5>
      </label>
      <div class="hidden peer-checked:block mt-4">
        <p class="text-gray-700 max-w-prose mx-auto md:mx-0">{otherInfo}</p>
      </div>
    </div>
  </div>
  <!-- CTA button -->
  <div class="my-md text-center md:text-left">
    <Linkbutton href="/stepone" label="START YOUR ORDER" variant="primary" />
  </div>
</div>
