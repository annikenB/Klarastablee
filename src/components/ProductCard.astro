---
import Linkbutton from "../components/Linkbutton.astro";

const {
  title = "Standard produkt",
  price = "Pris ikke oppgitt",
  details = [],
  otherInfo = [], // Brukes som array
  buttonLabel = "Contact us to order",
  href="https://mail.google.com/mail/?view=cm&to=infoklarastable@gmail.com",
} = Astro.props;
---

<div class="sticky top-4 self-start max-w-3xl">
  <div class="text-center md:text-left">
    <h1 class="text-primary-900">{title}</h1>
    <h5 class="leading-relaxed mt-2 text-primary-900 mb-sm">{price}</h5>
  </div>

  <!-- TABS -->
  <div class="items-center md:flex-row md:items-start text-center md:text-left">
    <!-- Description tab -->
    <div class="w-full md:w-1/2">
      <input type="radio" name="tabs" id="tab1" class="hidden peer" checked />
      <label
        for="tab1"
        class="inline-block py-2 cursor-pointer border-b-1 !border-white
        peer-checked:!text-primary-500 peer-checked:italic
        peer-checked:!border-primary-500 pb-1"
      >
        <h5 class="peer-checked:!text-primary-500 hover:italic">Description</h5>
      </label>
      <div class="hidden peer-checked:block mt-4">
        {
          details.length > 0 ? (
            <ul class="list-none font-display max-w-prose mx-auto md:mx-0 space-y-4">
              {details.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : (
            <p class="text-gray-700 max-w-prose mx-auto md:mx-0">
              Ingen ekstra informasjon tilgjengelig.
            </p>
          )
        }
      </div>
    </div>

    <!-- Additional services tab -->
    <div class="w-full md:w-1/2 mt-4 md:mt-0">
      <input type="radio" name="tabs" id="tab2" class="hidden peer" />
      <label
        for="tab2"
        class="inline-block py-2 cursor-pointer border-b-1 !border-white
        peer-checked:!text-primary-500 peer-checked:italic
        peer-checked:!border-primary-500 pb-1"
      >
        <h5 class="inline-block pb-1 hover:italic mt-sm">
          Additional services
        </h5>
      </label>
      <div class="hidden peer-checked:block mt-4">
        {
          otherInfo.length > 0 ? (
            <ul class="list-none font-display max-w-prose mx-auto md:mx-0 space-y-4">
              {otherInfo.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : (
            <p class="text-gray-700 max-w-prose mx-auto md:mx-0">
              No additional information.
            </p>
          )
        }
      </div>
    </div>
  </div>

  <!-- CTA button -->
  <div class="my-md text-center md:text-left">
    <Linkbutton href={href} label={buttonLabel} variant="primary" />
  </div>
</div>
