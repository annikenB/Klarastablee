---
import MainLayout from "../layouts/MainLayout.astro";
import Linkbutton from "../components/Linkbutton.astro";
---

<MainLayout title="Step Three">
  <article>
    <h1 class="text-center mt-40 md:p-xs">Customise your order</h1>
  </article>

  <article class="flex w-[250px] mx-auto justify-between p-5">
    <p>First step</p>
    <p>Second step</p>
    <p><span>Last step</span></p>
  </article>

  <div class="flex flex-col items-center justify-center">
    <div class="text-center max-w-xl px-4 mb-6">
      <p class="mb-4">
        Last step,<br />
        Please provide us with a small description about your thoughts about your
        order. <br />We will get beck yo you by email within 1-3 business days.
      </p>
    </div>

    <div class="max-w-2xl mx-auto">
      <label for="comment" class="block w-full text-center mb-2"
        ><p>Write a comment</p>
      </label>
      <textarea
        id="comment"
        name="comment"
        rows="8"
        placeholder="Write your thoughts here..."
        class="border-1 !border-primary-900 text-beige-700 w-[500px] px-4 py-3 rounded-none resize-none font-display"
      ></textarea>
    </div>

    <div class="max-w-xl mx-auto">
      <label for="images" class="block mb-2 text-center">
        <p>Upload your images</p>
      </label>
      <input
        id="images"
        name="images"
        type="file"
        accept="image/*"
        multiple
        class="block border-1 !border-primary-900 text-beige-700 w-[500px] px-4 py-2 cursor-pointer font-display"
      />
    </div>

    <div class="mt-md">
      <Linkbutton href="/steptwo" label="Back" variant="secondary" />
      <Linkbutton
        href="/orderconformation"
        label="Send Request"
        variant="primary"
      />
    </div>
  </div>
</MainLayout>
