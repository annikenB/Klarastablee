---
import MainLayout from "../layouts/MainLayout.astro";
import Linkbutton from "../components/Linkbutton.astro";
---

<MainLayout title="Step Two">
  <article>
    <h1 class="text-center mt-40 md:p-xs">Customise your order</h1>
  </article>

  <article class="flex w-[250px] mx-auto justify-between p-5">
    <p>First step</p>
    <p><span>Second step</span></p>
    <p>Last step</p>
  </article>

  <div class="flex flex-col items-center justify-center">
    <div class="text-center max-w-xl px-4 mb-6">
      <p>
        Second step,<br />
        Please provide us with information about catering and other services as well
        as how much help you want. Style preferences and special requests will be
        addressed in a subsequent discussion. <br /> What additional services are
        you interested in?
      </p>
    </div>

    <div class="max-w-xl mx-auto p-4 space-y-4">
      <label class="flex items-center justify-between gap-4 cursor-pointer">
        <p>Delivery in Copenhagen</p>
        <input type="checkbox" name="hibiscus" class="peer hidden" />
        <div
          class="w-5 h-5 border-1 !border-primary-900 peer-checked:bg-primary-500 transition-colors"
        >
        </div>
      </label>

      <label class="flex items-center justify-between gap-4 cursor-pointer">
        <p>Do you want a cake setup</p>
        <input type="checkbox" name="hibiscus" class="peer hidden" />
        <div
          class="w-5 h-5 border-1 !border-primary-900 peer-checked:bg-primary-500 transition-colors"
        >
        </div>
      </label>

      <label class="flex items-center justify-between gap-4 cursor-pointer">
        <p>Klara catering at your event</p>
        <input type="checkbox" name="mascarpone" class="peer hidden" />
        <div
          class="w-5 h-5 border-1 !border-primary-900 peer-checked:bg-primary-500 transition-colors"
        >
        </div>
      </label>

      <label class="flex items-center justify-between gap-4 cursor-pointer">
        <p>Rental of silver trays, stands</p>
        <input type="checkbox" name="egg" class="peer hidden" />
        <div
          class="w-5 h-5 border-1 !border-primary-900 peer-checked:bg-primary-500 transition-colors"
        >
        </div>
      </label>

      <label class="flex items-center justify-between gap-4 cursor-pointer">
        <p>Artistic tablescaping & curation</p>
        <input type="checkbox" name="sugar2" class="peer hidden" />
        <div
          class="w-5 h-5 border-1 !border-primary-900 peer-checked:bg-primary-500 transition-colors"
        >
        </div>
      </label>
    </div>
    <div class="text-center max-w-xl px-4">
      <p class="m-xs text-base">Add a comment</p>
      <input
        type="text"
        class="px-3 border-1 !border-primary-900 py-1 w-full text-center"
      />
    </div>
    <!-- knapperne -->
    <div class="mt-md">
      <Linkbutton href="/stepone" label="Back" variant="secondary" />
      <Linkbutton href="/stepthree" label="Next" variant="secondary" />
    </div>
  </div>
</MainLayout>
