---
import MainLayout from "../layouts/MainLayout.astro";
import Linkbutton from "../components/Linkbutton.astro";
import Cardone from "../components/Cardone.astro";
// import Newsletter from "../components/Newsletter.astro";
import celebrationCake from "../assets/images/celebrationCake.webp";
import Apollo from "../assets/images/apollo.webp";
import miniCake from "../assets/images/miniCake.webp";
---

<Newsletter />
<MainLayout title="Home">
  <article>
    <section class="relative w-full overflow-hidden">
      <div class="relative w-full h-[60vh] md:h-svh flex items-center justify-center">
        <video
          autoplay
          loop
          muted
          playsinline
          class="absolute top-0 left-0 w-full h-full object-cover"
        >
          <source src="indexvideo.MP4" type="video/mp4" />
        </video>
    
        <h1 class="!text-beige-100 relative z-10 text-center whitespace-nowrap">
          Personalised cakes, desserts and events
        </h1>
      </div>
    </section>

    <section id="sektion-1" class="px-4 pt-md">
      <h2 class="text-center">Your local cake dealer</h2>

      <p
        class="text-center max-w-4xl mx-auto pt-sm font-script font-display leading-relaxed sm:leading-loose"
      >
        Klaras Table is a <span>Copenhagen based culinary studio</span>,
        offering thoughtful <span>cakes</span> and <span>sweet treats</span> for
        events of all kinds. <br />
        From simple morning plates and petit fours, to handmade cakes for weddings
        and larger celebrations, <br />
        everything is thought out with eye for detail and a desire to combine culinary
        artistry and uncompromising taste. <br /><br />
        Klaras Table offer more than just desserts. We <span>cook</span>, <span
          >cater</span
        >, and <span>serve</span> as part of your event setting the food frame to
        any <br />
        gathering. The cakes are true centerpieces — and will be the first thing
        your guests will notice upon arrival, and certainly <br />
        something they'll remember when leaving. <br /><br />
        Whether you're planning something small and cozy or a larger gathering, <br
        />
        Klaras Table brings sweetness and artistic touch to the table. <br /><br
        />
        For further information or questions please reach out to
        <a
          href="https://mail.google.com/mail/?view=cm&to=infoklarastable@gmail.com"
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-primary-500"
          title="Send en e-mail til Klaras Table"
        >
          infoklarastable@gmail.com
        </a>
        <br />
        We'd love to help you<br /><code
          class="text-body-medium font-display text-primary-900;">&lt;3</code
        >
      </p>
    </section>

    <section
      class="max-w-6xl mx-auto text-center pt-lg"
      aria-labelledby="section-title-products"
    >
      <h2 id="section-title-products" class="text-2xl pb-sm">
        What are you looking for?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 px-s">
        <article>
          <a href="/produkter#cakes" aria-label="Shop Celebration Cakes">
            <Cardone
              title="Celebration Cakes"
              image={celebrationCake.src}
              alt="Celebration Cake with decorations"
            />
          </a>
        </article>

        <article>
          <a href="/produkter#cakes" aria-label="Shop Smaller Cakes">
            <Cardone
              title="Smaller Cakes"
              image={miniCake.src}
              alt="Selection of smaller cakes"
            />
          </a>
        </article>

        <article>
          <a href="/produkter#events" aria-label="Shop Events">
            <Cardone
              title="Events"
              image={Apollo.src}
              alt="Catering setup for events"
            />
          </a>
        </article>
      </div>

      <!-- Primær link-knapp -->
      <div class="py-sm">
        <Linkbutton href="/produkter" label="View all" variant="primary" />
      </div>
    </section>

    <!-- sektion 3, trustpilot -->
    <!-- <section id="sektion 3">
      <h2 class="text-center pt-lg">Trustpilot</h2>
      <div class="mx-md">
        <div class="">
          <div class="py-sm text-center">
            <Linkbutton
              href="https://dk.trustpilot.com"
              target="_blank"
              label="Read all Reviews here"
              variant="primary"
            />
          </div>
        </div>
      </div>
    </section> -->
  </article>
</MainLayout>
