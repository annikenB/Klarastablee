---
import MainLayout from "../layouts/MainLayout.astro";
import Linkbutton from "../components/Linkbutton.astro";
import { Image } from "astro:assets";

import logo from "../assets/images/secondaryLogo.webp";
import background from "../assets/images/newsletter.webp";
---

<MainLayout title="Step One">
  <article
    class="fixed top-0 left-0 w-full h-full flex justify-center items-center z-50 px-md"
  >
    <!-- Sløret bakgrunn -->
    <div
      id="overlay"
      class="absolute inset-0 bg-opacity-50 backdrop-blur-sm z-40 cursor-pointer"
    >
    </div>

    <div class="relative z-50">
      <!-- Bakgrunnsbilde -->
      <div
        class="absolute inset-0 flex justify-center items-center pointer-events-none z-0"
      >
        <Image
          src={background}
          alt="Newsletter background"
          class="object-contain max-w-none w-[110%] h-auto"
        />
      </div>

      <!-- Innhold -->
      <div
        class="p-0 max-w-5xl mx-auto relative flex overflow-hidden bg-transparent z-10"
      >
        <div
          class="flex-1 flex flex-col justify-center items-center p-6 px-lg bg-white bg-opacity-90 rounded-lg shadow-lg"
        >
          <h5 class="text-2xl font-semibold mb-2">
            Thank you for your request!
          </h5>
          <p class="text-center m-xs mb-4">
            We will get back to you within 1-3 business days
          </p>

          <div class="max-w-xl mx-auto text-center mt-4">
            <Image
              src={logo}
              alt="Secondary logo"
              class="max-w-[100px] mx-auto"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Script for clicking outside to return to index -->
    <script type="module" client:load>
      const overlay = document.getElementById("overlay");
      if (overlay) {
        overlay.addEventListener("click", () => {
          window.location.href = "/";
        });
      }
    </script>
  </article>
</MainLayout>
