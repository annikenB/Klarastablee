---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import celebrationCake from "../assets/images/bigcelebrationCake.webp";
import walkingCake from "../assets/images/biglilacc.webp";
import ProductCard from "../components/ProductCard.astro";
import cake2 from "../assets/images/big4.webp";
import tiramisu from "../assets/images/bigcakee.webp";
---

<MainLayout title="Produkt">
  <section
    class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-40 pb-sm px-4 md:px-0"
  >
    <!-- Høyre kolonne: Sticky produktkort vises først på mobil -->
    <div
      class="order-1 md:order-2 max-h-fit self-start md:sticky md:top-4 mt-4 md:mt-0 ml-md"
    >
      <ProductCard
        title="Celebration Cake"
        price="40 dkk each, min. 10 pieces"
        buttonLabel="Start your order"
        details={[
          "A true classy classic. We do different flavors, from brown butter, to almond, to lemon and coated in choc. A stunner on every table! ",
          "All cakes and desserts are planned in close collaboration with each client, each creation is unique and tailored to your wishes, dreams, and the occasion.",
        ]}
        otherInfo={[
          "Delivery near Copenhagen is 300 DKK",
          "Chef's fee at event 1,000 per hour",
          "Rental of silver tray etc. price is upon request",
          "Artistic tablescaping and curation, price by project",
        ]}
      />
    </div>

    <!-- Venstre kolonne: Bilder -->
    <div class="order-2 md:order-1 w-full">
      <form>
        <div class="space-y-2">
          <Image
            src={celebrationCake}
            alt="celebration cake"
            class="w-4/5 ml-auto"
          />
          <Image src={cake2} alt="celebration cake" class="w-4/5 ml-auto" />
          <Image src={tiramisu} alt="celebration cake" class="w-4/5 ml-auto" />
          <Image
            src={walkingCake}
            alt="celebration cake"
            class="w-4/5 ml-auto"
          />
        </div>
      </form>
    </div>
  </section>
</MainLayout>
