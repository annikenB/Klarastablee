---
import MainLayout from "../layouts/MainLayout.astro";
import Cardtwo from "../components/Cardtwo.astro";
import celebrationCake from "../assets/images/celebrationCake.webp";
import petitepies from "../assets/images/petite.webp";
import manyPies from "../assets/images/manyPies.webp";
import powderSugar from "../assets/images/powderSugar.webp";
import MBsetup from "../assets/images/MBsetup.webp";
import apollo from "../assets/images/apollo.webp";
import { Image } from "astro:assets";
import hover from "../assets/images/1.webp";
import event from "../assets/images/event.webp";
import event2 from "../assets/images/event2.webp";
import hover3 from "../assets/images/3.webp";
import hover4 from "../assets/images/4.webp";
import hover5 from "../assets/images/5.webp";
---

<MainLayout title="Shop All">
  <article>
    <section class="text-center pt-40 mx-xs">
      <h1 class="text-center">Cakes and Events</h1>
      <p
        class="text-center max-w-4xl mx-auto pt-sm font-script font-display leading-relaxed sm:leading-loose"
      >
        Dessert is the highlight of the event. Make yours stand out. We offer
        <span>cakes</span> and <span>desserts </span>for your next <span
          >commercial</span
        > or <span>private event</span>. All orders are <span
          >made to order</span
        > can be adjusted for allergies or specific needs. We also complementary
        delivery near Cph, table set ups, and catering in the Copenhagen area.
      </p>
      <br />
      <p>
        Please reach out to us for further questions or inquiries - we would
        love to assist you
      </p>
      <a
        href="https://mail.google.com/mail/?view=cm&to=infoklarastable@gmail.com"
        target="_blank"
        rel="noopener noreferrer"
        class="underline hover:text-primary-500 font-display"
        title="Send en e-mail til Klaras Table"
      >
        infoklarastable@gmail.com
      </a>
    </section>
  </article>

  <section class="relative pt-md pb-sm">
    <h2 class="text-center mb-xs">Shop all</h2>

    <!-- <div class="relative w-full overflow-hidden px-lg"> -->
      <div class="relative w-full overflow-hidden px-4 md:px-lg">
      <!-- Scroll container with transition -->
      <div
        class="flex gap-7 overflow-x-auto scroll-smooth snap-x snap-mandatory scrollbar-hide p-4"
      >
        <div
          id="shopCarousel"
          class="flex transition-transform duration-700 ease-in-out gap-2"
        >
          <div class="flex gap-2 w-max">
            <div class="shrink-0 snap-start w-40 md:w-[300px]">
              <a href="/madeleines">
                <Cardtwo
                  title="Madeleines"
                  image={powderSugar.src}
                  hoverImage={hover5.src}
                  price="40 dkk pr. person - min. 10 servings"
                  buttonLabel="Read More"
                />
              </a>
            </div>
            <div class="shrink-0 snap-start w-40 md:w-[300px]">
              <a href="/tinyTreats">
                <Cardtwo
                  title="Tiny Treats"
                  image={hover.src}
                  hoverImage={manyPies.src}
                  price="50 dkk pr. person - min. 10 servings"
                  buttonLabel="Read More"
                />
              </a>
            </div>
            <div class="shrink-0 snap-start w-40 md:w-[300px]">
              <a href="/petitePies">
                <Cardtwo
                  title="Petite Pies"
                  image={petitepies.src}
                  hoverImage={hover3.src}
                  price="60 dkk pr. person - min. 10 servings"
                  buttonLabel="Read more"
                />
              </a>
            </div>
            <div class="shrink-0 snap-start w-40 md:w-[300px]">
              <a href="/celebrationCake">
                <Cardtwo
                  title="Celebration Cake"
                  image={celebrationCake.src}
                  hoverImage={hover4.src}
                  price="From 95 dkk pr. person - min. 10 servings"
                  buttonLabel="Read More"
                />
              </a>
            </div>
            <div class="shrink-0 snap-start w-40 md:w-[300px]">
              <a href="/privateEvent">
                <Cardtwo
                  title="Private Event"
                  image={event.src}
                  hoverImage={event2.src}
                  price="From 200 dkk pr. guest, 10 servings"
                  buttonLabel="Read more"
                />
              </a>
            </div>
            <div class="shrink-0 snap-start w-40 md:w-[300px]">
              <a href="/comEvent">
                <Cardtwo
                  title="Commercial Event"
                  image={apollo.src}
                  hoverImage={MBsetup.src}
                  price="from 200 pr. guest, min. 20 servings"
                  buttonLabel="Read More"
                />
              </a>
            </div>
          </div>
        </div>
      </div>

    <!-- overblik -->
    <section id="eventsandcakes" class="pt-md">
      <section id="events">
        <h2 class="text-center mt-sm mb-sm">Events and Catering</h2>
        <div class="flex justify-center items-center gap-4">
          <div class="shrink-0 snap-start w-40 md:w-[350px]">
            <a href="/privateEvent">
              <Cardtwo
                title="Private Event"
                image={event.src}
                hoverImage={event2.src}
                price="from 200 pr. guest, 10 servings"
                buttonLabel="Read more"
                href="/privateEvent"
              />
            </a>
          </div>
          <div class="shrink-0 snap-start w-40 md:w-[350px]">
            <a href="/comEvent">
              <Cardtwo
                title="Commercial Event"
                image={apollo.src}
                hoverImage={MBsetup.src}
                price="from 200 pr. guest, min. 20 servings"
                buttonLabel="Read More"
                href="/comEvent"
              />
            </a>
          </div>
        </div>
      </section>

      <section id="cakes">
        <h2 class="text-center mt-md mb-sm">Cakes and sweet treats</h2>
        <div class="flex justify-center items-center gap-4">
          <div class="shrink-0 snap-start w-40 md:w-[350px]">
            <a href="/madeleines">
              <Cardtwo
                title="Madeleines"
                image={powderSugar.src}
                hoverImage={hover5.src}
                price="40 dkk pr. person - min. 10 servings"
                buttonLabel="Read More"
                href="/madeleines"
              />
            </a>
          </div>
          <div class="shrink-0 snap-start w-40 md:w-[350px]">
            <a href="/tinyTreats">
              <Cardtwo
                title="Tiny Treats"
                image={hover.src}
                hoverImage={manyPies.src}
                price="50 dkk pr. person - min. 10 servings"
                buttonLabel="Read More"
                href="/tinyTreats"
              />
            </a>
          </div>
        </div>
      </section>
      <div class="flex justify-center items-center gap-4 mt-sm">
        <div class="shrink-0 snap-start w-40 md:w-[350px]">
          <a href="/petitePies">
            <Cardtwo
              title="Petite Pies"
              image={petitepies.src}
              hoverImage={hover3.src}
              price="60 dkk pr. person - min. 10 servings"
              buttonLabel="Read more"
              href="/petitePies"
            />
          </a>
        </div>
        <div class="shrink-0 snap-start w-40 md:w-[350px]">
          <a href="/celebrationCake">
            <Cardtwo
              title="Celebration Cake"
              image={celebrationCake.src}
              hoverImage={hover4.src}
              price="From 95 dkk pr. person - min. 10 servings"
              buttonLabel="Read More"
              href="/celebrationCake"
            />
          </a>
        </div>
      </div>
    </section>
  </section>
  <script>
    let shopIndex = 0;
    const shopItemsPerView = 3; // Justér for mobil vs desktop om ønsket
    const shopCarousel = document.getElementById("shopCarousel");
    const shopTotalItems = shopCarousel.children[0].children.length;

    const shopPrev = document.getElementById("shopPrev");
    const shopNext = document.getElementById("shopNext");

    function updateShopCarousel() {
      const offset = (-shopIndex * 100) / shopItemsPerView;
      shopCarousel.style.transform = `translateX(${offset}%)`;
    }
  </script>
</MainLayout>
