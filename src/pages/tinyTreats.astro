---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import ProductCard from "../components/ProductCard.astro";
import manyPies from "../assets/images/bigmanyPies.webp";
import pies2 from "../assets/images/big1.webp";
import pies3 from "../assets/images/bigminiCake.webp";
---

<MainLayout title="Produkt">
  <section
    class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-40 pb-sm px-4 md:px-0"
  >
    <!-- Høyre kolonne: Sticky produktkort vises først på mobil -->
    <div
      class="order-1 md:order-2 max-h-fit self-start md:sticky md:top-4 mt-4 md:mt-0 ml-md"
    >
      <ProductCard
        title="Tiny Treats"
        price="65 dkk each, min. 10 pieces"
        buttonLabel="Start your order"
        details={[
          "Like petite pies, but bigger. A one pax dessert pie in various flavors. Go classic french with a tarte au citron, make a tiny cheese cake or a vanilla shortcrust pie with seasonal fruit on top. ",
          "All cakes and desserts are planned in close collaboration with each client, each creation is unique and tailored to your wishes, dreams, and the occasion.",
        ]}
        otherInfo={[
          "Delivery near Copenhagen is 300 DKK",
          "Chef's fee at event 1,000 per hour",
          "Rental of silver tray etc. price is upon request",
          "Artistic tablescaping and curation, price by project",
        ]}
      />
    </div>

    <!-- Venstre kolonne: Bilder -->
    <div class="order-2 md:order-1 w-full">
      <form class="">
        <div class="space-y-4">
          <Image src={pies2} alt="tiny treat" class="w-4/5 ml-auto" />
          <Image src={manyPies} alt="tiny treat" class="w-4/5 ml-auto" />
          <Image src={pies3} alt="tiny treat" class="w-4/5 ml-auto" />
        </div>
      </form>
    </div>
  </section>
</MainLayout>
