---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Contact">
  <article>
    <section>
      <section class="text-center pt-40 pb-sm">
        <h1 class="text-center pb-sm">Contact</h1>
        <p
          class="text-center max-w-4xl mx-auto pt-sm font-script font-display leading-relaxed sm:leading-loose"
        >
          Feel free to reach out with any questions, we're always happy to help!
          You can contact us via Instagram DM or email. We aim to respond as
          quickly as possible, but please allow <span>1–3 business days </span> for
          a reply. please reach out to ud at: <br /><br />
          <a
            href="https://mail.google.com/mail/?view=cm&to=infoklarastable@gmail.com"
            target="_blank"
            rel="noopener noreferrer"
            class="underline hover:text-primary-500"
            title="Send en e-mail til Klaras Table"
          >
            infoklarastable@gmail.com
          </a>
          <br />
          <a
            href="https://www.instagram.com/klaras.table/"
            class="hover:text-primary-500"
            target="_blank">Instagram</a
          >
          <br /><br />
          We look forward to hearing from you<br /><code
            class="text-body-medium font-display text-primary-900;">&lt;3</code
          >
        </p>
      </section>
    </section>
  </article>
</MainLayout>
