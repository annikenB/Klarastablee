---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import ProductCard from "../components/ProductCard.astro";
import petitepies from "../assets/images/petitepies.webp";
import MBsetup from "../assets/images/MBsetup.webp";
import apollo from "../assets/images/apollo.webp";
import cc from "../assets/images/cc.webp";
import ccccc from "../assets/images/ccccc.webp";
---

<MainLayout title="Produkt">
  <section
    class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-40 pb-sm px-4 md:px-0"
  >
    <!-- Høyre kolonne: Sticky produktkort vises først på mobil -->
    <div
      class="order-1 md:order-2 max-h-fit self-start md:sticky md:top-4 mt-4 md:mt-0 ml-md"
    >
      <ProductCard
        title="Commercial Events"
        price="From 300 DKK per Guest"
        buttonLabel="Start your order"
        details={[
          "We collaborate with brands to create immersive experiences — from fashion launches to corporate gatherings. With creative tablescapes, tailored menus, and a detail-driven approach, we help elevate your brand and leave a lasting impression on your guests. We handle everything from desserts and treats to full breakfast spreads.",
          "All cakes and desserts are planned in close collaboration with each client, each creation is unique and tailored to your wishes, dreams, and the occasion.",
        ]}
        otherInfo={[
          "Delivery near Copenhagen is 300 DKK",
          "Chef's fee at event 1,000 per hour",
          "Rental of silver tray etc. price is upon request",
          "Artistic tablescaping and curation, price by project",
        ]}
      />
    </div>
    <!-- Venstre kolonne: Bilder -->
    <div class="order-2 md:order-1 w-full">
      <form>
        <div class="space-y-4 m-md">
          <Image src={apollo} alt="event" class="Apollo event" />
          <Image src={MBsetup} alt="event" class="H&M x Magda Bytrum event" />
          <Image src={ccccc} alt="event" class="" />
          <Image src={cc} alt="event" class="" />
          <Image src={ccccc} alt="event" class="" />
        </div>
      </form>
    </div>
  </section>
</MainLayout>
